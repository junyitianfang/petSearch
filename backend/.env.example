# 高德开放平台「Web服务」Key（后端调POI搜索/行政区划接口用，不要用前端的JS Key）
AMAP_WEB_KEY=

# 智谱开放平台Key（https://open.bigmodel.cn 右上角API密钥）
# 联网搜索城市养宠数据用，需在控制台充值/开通「联网搜索」资源包（搜索源首选）
ZHIPU_API_KEY=

# 博查搜索Key（https://open.bochaai.com 注册，中文内容覆盖好，备用搜索源）
BOCHA_API_KEY=

# Tavily搜索Key（https://app.tavily.com，备用搜索源，每月1000次免费）
TAVILY_API_KEY=
